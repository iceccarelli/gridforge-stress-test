{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridforge-stress.invalid/schemas/source/1",
  "title": "Source registry v1",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "source-registry/1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "owner",
        "locator",
        "allowed_hosts",
        "access_status",
        "formats",
        "acquisition_method",
        "release_identity",
        "license_attribution",
        "semantics",
        "units",
        "time_convention",
        "geography",
        "credential_env",
        "limitations",
        "verification",
        "live_fetch"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "pattern": "^https://"
        },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          }
        },
        "access_status": {
          "enum": [
            "public",
            "api_key_required",
            "registration_required",
            "restricted",
            "unverified"
          ]
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acquisition_method": {
          "enum": [
            "http_download",
            "http_api",
            "manual_download",
            "blocked"
          ]
        },
        "release_identity": {
          "type": "string"
        },
        "license_attribution": {
          "type": "string"
        },
        "semantics": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "time_convention": {
          "type": "string"
        },
        "geography": {
          "type": "string"
        },
        "credential_env": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allowed_content_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "live_fetch": {
          "enum": [
            "enabled",
            "disabled_until_verified",
            "blocked_until_authorized"
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_on",
            "basis"
          ],
          "properties": {
            "status": {
              "enum": [
                "unverified",
                "search_snippet_only",
                "publisher_page_read"
              ]
            },
            "checked_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "basis": {
              "type": "string"
            }
          }
        },
        "probe_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
